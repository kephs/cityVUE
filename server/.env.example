NODE_ENV=development
# Independent local development is the default. Client deployments require
# explicit profile selection and separately approved resources.
CITYVUE_DEPLOYMENT_PROFILE=development
CITYVUE_ENABLE_EXTERNAL_IDENTITY=false
PORT=3000
APP_NAME=cityvue-api
APP_VERSION=0.1.0
LOG_LEVEL=info

# ADR-027 F060.3C-2d. DATABASE_URL is the RUNTIME credential only. Its intended
# identity is reqro_runtime, which owns nothing, holds no schema CREATE and
# cannot run migrations. Local development placeholder only; replace it in an
# uncommitted server/.env.
DATABASE_URL=postgresql://reqro_runtime:reqro_runtime_dev_only@localhost:5432/cityvue

# The MIGRATION credential, separate on purpose. Its identity is reqro_migrate,
# which holds no authority until the migration command explicitly assumes
# reqro_owner. The migration command NEVER falls back to DATABASE_URL under
# NODE_ENV=production; a development/test fallback exists and is reported.
# The runtime must never read this value.
MIGRATION_DATABASE_URL=postgresql://reqro_migrate:reqro_migrate_dev_only@localhost:5432/cityvue

# The owner role migrations assume. Infrastructure owned, a plain lower-case
# identifier, and never an operator or CLI argument. Defaults to reqro_owner.
REQRO_DATABASE_OWNER_ROLE=reqro_owner

# The deployment-owned application schema, pinned on the runtime, migration and
# operator connections at startup. Infrastructure owned: there is no --schema
# flag, reserved namespaces are refused, and a search_path carried in a
# connection string is stripped before the pin is applied. Normally public.
REQRO_DEPLOYMENT_SCHEMA=public

# Production requires verify-full; disable is development/test only. require is rejected.
# Do not put SSL/TLS or host override parameters in DATABASE_URL or
# MIGRATION_DATABASE_URL. An `options` parameter is stripped from both, because
# a connection-string options value overrides the application's own pin.
DATABASE_SSL_MODE=disable
# Optional approved PEM CA bundle, mounted outside the repository/image; verify-full only.
# Omit to use Node default trusted CAs. Never commit production certificate material.
# DATABASE_SSL_CA_FILE=/run/certificates/postgresql-ca.pem
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=30000

# ADR-025 tenant resolution. `development` serves one explicitly configured
# Organization to anonymous callers and is rejected in production and in any
# client profile. `registry` is the future verified hostname resolver; it is
# accepted configuration state, but no resolver exists yet, so the API refuses
# to start under it. This is not a production tenant-selection mechanism.
TENANT_RESOLUTION_STRATEGY=development
# Required by the development strategy; there is no fixture fallback. This UUID
# matches the local development seed. Must be unset under the registry strategy.
DEVELOPMENT_ORGANIZATION_ID=10000000-0000-4000-8000-000000000001

# Local/test-only canonical details reads. Defaults false and is rejected in production.
ENABLE_DEVELOPMENT_SERVICE_REQUEST_READS=false
ENABLE_DEVELOPMENT_STAFF_ACTIONS=false
# Synthetic development StaffIdentity UUID; never an Entra object ID.
DEVELOPMENT_STAFF_ACTOR_ID=90000000-0000-4000-8000-000000000001

# Optional Entra adapter. Independent development may use only personally
# controlled test tenants, with CITYVUE_ENABLE_EXTERNAL_IDENTITY=true.
# Never use client tenant settings without authorization.
# ENTRA_TENANT_ID=<tenant-uuid>
# ENTRA_API_CLIENT_ID=<api-app-client-uuid>
# ENTRA_EXPECTED_AUDIENCE=api://<api-app-client-uuid>
ENTRA_REQUIRED_SCOPE=access_as_user

# F027 explicit one-time development provisioning inputs (set in local process
# environment; never commit personal IDs or grant choices).
# F027_ENTRA_OBJECT_ID=<personal-development-object-uuid>
# F027_ORGANIZATION_ID=<fictional-development-organization-uuid>
# F027_GRANT_GEOSPATIAL_READ=false

# Separate, personally controlled integration database. Never use production
# or City resources. Tests skip safely when this is unset.
# TEST_DATABASE_URL=postgresql://<local-test-connection>

# Deterministic test harness only. Never represents a real municipal boundary.
LOCATION_ELIGIBILITY_PROVIDER=disabled
ENABLE_DEVELOPMENT_LOCATION_ELIGIBILITY=false
LOCATION_ELIGIBILITY_TIMEOUT_MS=3000

CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120

# OpenTelemetry exporter activation is deferred; these preserve the integration boundary.
OTEL_SERVICE_NAME=cityvue-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# F020: metadata-only AI foundation. Requires configured Entra and explicit RBAC grants.
AI_ENABLED=false
# F020 rejects true; no chat endpoint or network-backed provider exists.
AI_CHAT_ENABLED=false

# F021 internal test harness only; no HTTP generation route or registered provider.
# True is forbidden in production and requires AI_ENABLED.
AI_TEST_EXECUTION_ENABLED=false

# F046 development foundation only. Never enable in a client/production profile.
ENABLE_DEVELOPMENT_ATTACHMENTS=false

# F051 server-side suppression: integer 5–1000; never below 5.
PARTICIPATION_SUPPRESSION_THRESHOLD=5
# Explicit opt-in for the fictional area provisioning CLI only; no permission grants.
F051_FICTIONAL_DATA_ONLY=false
