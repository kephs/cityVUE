NODE_ENV=development
PORT=3000
APP_NAME=cityvue-api
APP_VERSION=0.1.0
LOG_LEVEL=info

# Local development placeholder only. Replace it in an uncommitted server/.env.
DATABASE_URL=postgresql://cityvue:cityvue_dev_only@localhost:5432/cityvue
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=30000

CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120

# OpenTelemetry exporter activation is deferred; these preserve the integration boundary.
OTEL_SERVICE_NAME=cityvue-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
