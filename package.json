{
  "name": "cityvue",
  "version": "1.0.0",
  "private": true,
  "description": "CityVUE - Resident Engagement Platform",
  "source": "index.html",
  "scripts": {
    "start": "parcel index.html --open",
    "build": "npm run build:react",
    "build:legacy": "parcel build index.html --dist-dir dist",
    "build:react": "vite build react --outDir ../dist-react --emptyOutDir",
    "legacy:start": "parcel index.html --open",
    "legacy:build": "npm run build:legacy",
    "react:start": "vite react",
    "react:build": "npm run build:react",
    "react:preview": "vite preview react --outDir ../dist-react",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/Catalog.test.js test/Issue.test.js test/IssueListUtils.test.js test/IssueService.test.js test/LegacyIssueMatching.test.js test/Statistics.test.js test/ThemePreferences.test.js",
    "test:react": "vitest run --config vitest.config.mjs --maxWorkers=1",
    "clean": "rimraf dist .parcel-cache",
    "deploy": "npm run deploy:react",
    "deploy:react": "npm run build:react && firebase deploy --only hosting --config firebase.json --project cityvue-1",
    "deploy:legacy": "npm run build:legacy && firebase deploy --only hosting --config firebase.legacy.rollback.json --project cityvue-1",
    "serve": "firebase emulators:start --only hosting --config firebase.json --project cityvue-1",
    "server:start": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "server:typecheck": "npm --prefix server run typecheck",
    "server:test": "npm --prefix server test",
    "server:test:e2e": "npm --prefix server run test:e2e",
    "server:test:db": "npm --prefix server run test:db",
    "server:lint": "npm --prefix server run lint",
    "database:migrate": "npm --prefix server run migration:up",
    "database:migrate:revert": "npm --prefix server run migration:down",
    "database:status": "npm --prefix server run migration:status"
  },
  "keywords": [
    "cityvue",
    "municipal",
    "javascript",
    "firebase",
    "parcel"
  ],
  "author": "Kyle Josephs",
  "license": "ISC",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "jsdom": "^29.1.1",
    "parcel": "^2.16.4",
    "rimraf": "^6.0.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "4.5.1",
    "firebase": "^12.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  }
}
