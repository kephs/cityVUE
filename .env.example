FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
VITE_CITYVUE_DATA_SOURCE=legacy
# Local/legacy demo default. Customer production builds require client + api.
VITE_CITYVUE_DEPLOYMENT_PROFILE=development
VITE_CITYVUE_API_BASE_URL=http://localhost:3000/api/v1
# For a client build remove/empty the API override above; do not set /api/v1.
# See docs/features/F060-4A-2A-production-serving-configuration.md.
# Optional local API + Entra mode. Real identifiers belong only in ignored environment configuration.
# VITE_ENTRA_TENANT_ID=<tenant-uuid>
# VITE_ENTRA_WEB_CLIENT_ID=<spa-app-client-uuid>
# VITE_ENTRA_API_SCOPE=api://<api-app-client-uuid>/access_as_user
